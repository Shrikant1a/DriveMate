# DriverOnDemand Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Supported types: mysql | sqlite
DB_TYPE=sqlite
DB_FILE=./database.sqlite

# MySQL Configuration (Used when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=driverondemand

# Authentication Secrets
JWT_SECRET=driverondemand_production_jwt_secret_key_super_secure_9876543210
JWT_EXPIRES_IN=7d

# Payment Gateway (Razorpay Sandbox/Production)
RAZORPAY_KEY_ID=rzp_test_sample_key_12345
RAZORPAY_KEY_SECRET=sample_secret_key_67890
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_abcde

# Client Origin
CLIENT_URL=http://localhost:3000

